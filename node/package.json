{
  "name": "@fastn-ai/sdk",
  "version": "0.4.2",
  "description": "Official fastn SDK for Node.js and TypeScript: the platform API (generated from the OpenAPI spec) and workspace tool calls",
  "license": "MIT",
  "author": "fastn",
  "homepage": "https://github.com/fastn-ai/fastn-sdk/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastn-ai/fastn-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/fastn-ai/fastn-sdk/issues"
  },
  "keywords": [
    "fastn",
    "sdk",
    "integrations",
    "mcp",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "codegen": [
        "./dist/codegen.d.ts"
      ]
    }
  },
  "bin": {
    "fastn-sdk-tools": "./dist/cli/fastn-sdk-tools.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen.d.ts",
        "default": "./dist/codegen.js"
      },
      "require": {
        "types": "./dist/codegen.d.cts",
        "default": "./dist/codegen.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run generate && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "lint:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run build",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "test:live": "LIVE=1 vitest run test/live --no-file-parallelism",
    "spec:refresh": "tsx scripts/refresh-spec.ts",
    "generate:tools": "tsx src/cli/fastn-sdk-tools.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "json-schema-to-typescript": "^16.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^22.0.0",
    "publint": "^0.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
